{
  "name": "dl-meta-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:builds",
    "build:builds": "tsc && VITE_PUBLIC_BASE=/builds/ VITE_ROUTER_BASE=/builds/ VITE_API_BASE=/builds/api vite build",
    "build:ddl": "tsc && VITE_PUBLIC_BASE=/videos/ VITE_ROUTER_BASE=/ VITE_API_BASE=/api VITE_SHELL=ddl vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.3",
    "vite": "^8.1.5"
  }
}
